  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response body includes the attributes username, password, and accessToken\", function(){\r\n    pm.expect(pm.response.json()).to.have.property('username');\r\n    pm.expect(pm.response.json()).to.have.property('password');\r\n    pm.expect(pm.response.json()).to.have.property('accessToken');\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"userName\": \"stefan9616\",\r\n    \"password\": \"stefan9616\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/api/User/Authentication",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "api",
            "User",
            "Authentication"
          ]
        }
      },
      "response": []
