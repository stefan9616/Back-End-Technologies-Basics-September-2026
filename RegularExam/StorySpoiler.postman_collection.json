    {
      "name": "Create a New Story Spoiler",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const words = [\"LastSummer\", \"Midnight\", \"Horizon\", \"SomeStory\", \"Kingdom\", \"Castle\", \"Before\", \"After\", \"Shadow\"];\r\nconst randomWord = words[Math.floor(Math.random() * words.length)];\r\nconst randomDigits = Math.floor(Math.random() * 1000);\r\nconst storyTitle = randomWord + randomDigits;\r\n\r\npm.collectionVariables.set(\"storyTitle\", storyTitle);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response have 'Successfully created!' message\", function() {\r\n    pm.expect(pm.response.json().msg).to.eql('Successfully created!');\r\n});\r\n\r\npm.collectionVariables.set(\"storyId\", pm.response.json().storyId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"title\": \"{{storyTitle}}\",\r\n    \"description\": \"My story test description\",\r\n    \"url\": \"\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/api/Story/Create",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "api",
            "Story",
            "Create"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Search Story",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is non-empty array\", function(){\r\n\r\n    pm.expect(pm.response.json()).to.be.an(\"array\");\r\n    pm.expect(pm.response.json().length).to.be.greaterThan(0);\r\n});\r\nconst storyTitle = pm.variables.get(\"storyTitle\");\r\n\r\npm.test(\"Response is an array and contains searched story title\", function () {\r\n    const response = pm.response.json();\r\n    const storyTitle = pm.variables.get(\"storyTitle\");\r\n\r\n    pm.expect(response).to.be.an(\"array\");\r\n\r\n    pm.expect(\r\n        response.some(story => story.title === storyTitle)\r\n    ).to.be.true;\r\n});\r\n\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/api/Story/Search?keyword={{storyTitle}}",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "api",
            "Story",
            "Search"
          ],
          "query": [
            {
              "key": "keyword",
              "value": "{{storyTitle}}"
            }
          ]
        }
      },
      "response": []
