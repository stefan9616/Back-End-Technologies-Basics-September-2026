    {
      "name": "Create a list on board",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\nvar jsonData = pm.response.json();\n\npm.test(\"Response has all the expected properties\", function (){\n    // The response contains more keys than the original test expected\n    pm.expect(jsonData).to.include.keys('id', 'name', 'closed', 'color', 'idBoard', 'pos');\n});\n\npm.test(\"'close' is false and of type boolean\", function (){\n    pm.expect(jsonData.closed).to.be.a('boolean');\n    pm.expect(jsonData.closed).to.be.false;\n});\n\npm.test(\"'idBoard' matches expected boardId\", function(){\n    var expectedBoardId = pm.variables.get(\"boardId\");\n    pm.expect(jsonData.idBoard).to.eql(expectedBoardId);\n});\n\npm.test(\"name matches expected listName\", function() {\n    // Use pm.variables.get to match the variable set in the pre-request script\n    pm.expect(jsonData.name).to.equal(pm.variables.get(\"listName\"));\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var uniqueName = \"List\" + Math.floor(Math.random() * 10000);\r\n\r\npm.collectionVariables.set('listName', uniqueName);"
            ]
          }
        }
      ],
