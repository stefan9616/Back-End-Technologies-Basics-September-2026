    {
      "name": "Create New Food",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const words = [\"Salata\", \"Pizza\", \"Pasta\", \"Burger\", \"Sushi\", \"Steak\", \"Fish\", \"Chicken\", \"Taco\", \"Pancakes\"];\r\nconst randomWord = words[Math.floor(Math.random() * words.length)];\r\nconst randomDigits = Math.floor(Math.random() * 1000);\r\nconst randomFood = randomWord + randomDigits;\r\n\r\npm.collectionVariables.set(\"randomFood\", randomFood);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response body have property foodId\", function() {\r\n    pm.expect(pm.response.json()).to.have.property('foodId');\r\n});\r\n\r\npm.collectionVariables.set(\"foodId\", pm.response.json().foodId);\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n\"name\": \"{{randomFood}}\",\r\n\"description\": \"Test description for food\",\r\n\"url\": \"\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/api/Food/Create",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "api",
            "Food",
            "Create"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Search by Food Name",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n    const foodName = pm.variables.get(\"randomFood\");\r\n\r\npm.test(\"Response is an array and contains searched food name\", function () {\r\n    const response = pm.response.json();\r\n    const foodName = pm.variables.get(\"randomFood\");\r\n\r\n    pm.expect(response).to.be.an(\"array\");\r\n\r\n    pm.expect(\r\n        response.some(food => food.name === foodName)\r\n    ).to.be.true;\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/api/Food/Search?keyword={{randomFood}}",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "api",
            "Food",
            "Search"
          ],
          "query": [
            {
              "key": "keyword",
              "value": "{{randomFood}}"
