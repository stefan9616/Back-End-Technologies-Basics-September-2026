      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response body includes username, password and accessToken\", function () {\r\n    pm.expect(pm.response.json()).to.have.property(\"username\");\r\n    pm.expect(pm.response.json()).to.have.property(\"password\");\r\n    pm.expect(pm.response.json()).to.have.property(\"accessToken\");\r\n})"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n\"userName\": \"Stefan96\", \r\n\"password\": \"Stefan9616\"\r\n}\r\n",
